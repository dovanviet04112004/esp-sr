# Copy to .env; values here are placeholders (KEHOACH 4.9). srhost/config.py reads every one of them.
SRPIPE_DATA_ROOT=/mnt/e/esp-sr-data
SRHOST_BOARD=board_b
SRHOST_STREAM_BIND=0.0.0.0
# The board connects here: set the same port in its NVS device/stream_port.
SRHOST_STREAM_PORT=7700
# Broker of deploy/: the Docker Desktop port reaches WSL at localhost.
SRHOST_MQTT_HOST=localhost
SRHOST_MQTT_PORT=1883
# The srhost row of deploy/emqx/users.csv.
SRHOST_MQTT_USER=srhost
SRHOST_MQTT_PASS=replace-me-host
