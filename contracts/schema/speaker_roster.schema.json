{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sr/speaker_roster",
  "title": "speaker_roster",
  "description": "Retained copy of the speakers a board holds: who has a voiceprint, and an enrolment under way.",
  "type": "object",
  "additionalProperties": false,
  "required": ["deviceId", "version", "check", "speakers"],
  "properties": {
    "deviceId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{4,32}$", "maxLength": 32},
    "version": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "check": {"type": "boolean"},
    "speakers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "enrolled"],
        "properties": {
          "id": {"type": "string", "pattern": "^spk_[0-9]{3}$", "maxLength": 7},
          "name": {"type": "string", "minLength": 1, "maxLength": 31},
          "enrolled": {"type": "boolean"}
        }
      }
    },
    "enrollingId": {"type": "string", "pattern": "^spk_[0-9]{3}$", "maxLength": 7},
    "enrolCount": {"type": "integer", "minimum": 0, "maximum": 255}
  }
}
