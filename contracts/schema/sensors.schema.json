{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sr/sensors",
  "title": "sensors",
  "description": "Board C's peripherals beside the camera. A device that failed at boot leaves its object out.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deviceId",
    "boot",
    "uptimeS",
    "gps",
    "ir"
  ],
  "properties": {
    "deviceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{4,32}$",
      "maxLength": 32
    },
    "boot": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "uptimeS": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "gps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hasFix",
        "latE7",
        "lonE7",
        "satellites",
        "inView",
        "antennaOpen"
      ],
      "properties": {
        "hasFix": {
          "type": "boolean"
        },
        "latE7": {
          "type": "integer",
          "minimum": -900000000,
          "maximum": 900000000
        },
        "lonE7": {
          "type": "integer",
          "minimum": -1800000000,
          "maximum": 1800000000
        },
        "satellites": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "inView": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "antennaOpen": {
          "type": "boolean"
        }
      }
    },
    "ir": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "hits"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "hits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accelMg",
        "gyroDpsE1",
        "tempCE1"
      ],
      "properties": {
        "accelMg": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": -32768,
            "maximum": 32767
          }
        },
        "gyroDpsE1": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": -32768,
            "maximum": 32767
          }
        },
        "tempCE1": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        }
      }
    },
    "adc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channelsMv"
      ],
      "properties": {
        "channelsMv": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": -32768,
            "maximum": 32767
          }
        }
      }
    }
  }
}
