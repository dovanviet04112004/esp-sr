{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sr/ack",
  "title": "ack",
  "description": "The server keeps every part one capture's record names: the board may drop that capture's pending mark.",
  "type": "object",
  "additionalProperties": false,
  "required": ["boot", "captureSeq"],
  "properties": {
    "boot": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "captureSeq": {"type": "integer", "minimum": 0, "maximum": 4294967295}
  }
}
