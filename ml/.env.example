# Copy to .env; values here are placeholders (KEHOACH 4.9).
SRPIPE_DATA_ROOT=/mnt/e/esp-sr-data
# SRPIPE_CHIP=esp32s31 goes on one command, never in .env, so the S3 stays every other command's chip (ADR-0046).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Mozilla Data Collective, Profile > API: Common Voice downloads only through it.
MDC_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Kaggle, Settings > API.
KAGGLE_API_TOKEN=KGAT_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CadPro ML, the office training web: its address and a login.
CADPRO_ML_URL=http://host:8088
CADPRO_ML_USER=username
CADPRO_ML_PASSWORD=xxxxxxxx
