menu "esp-sr application"

    config APP_CONSOLE
        bool "Console that writes NVS over UART"
        default n
        help
            On in dev, bench and ci. A shipped build must not carry a console
            that can rewrite every NVS key (KEHOACH 6.2).

    choice APP_BOARD
        prompt "Board, which picks the pin table of app_config.h"
        default APP_BOARD_B
        help
            Board B has two INMP441 and no camera. Board C has one INMP441,
            a MAX98357A and an OV5640 (KEHOACH 2.1, 2.2).

        config APP_BOARD_B
            bool "Board B"
        config APP_BOARD_C
            bool "Board C"
    endchoice

    config APP_CAMERA_ENABLE
        bool "Camera and SD card: photographs and detect on command"
        depends on APP_BOARD_C
        default y
        help
            Board C's image path (KEHOACH 3.19). Off means drv_camera, drv_sd
            and svc_vision build empty and nhin_task is never created.

    config APP_SPEAKER_ENABLE
        bool "Speaker fitted: open I2S TX and run noi_task"
        default n
        help
            Board B has no amplifier until E10. Off means drv_audio opens RX
            only, noi_task is never created, and replies stay MQTT events
            (KEHOACH 2.1).

    config APP_MIC_COUNT
        int "INMP441 microphones on the I2S data line"
        range 1 2
        default 2
        help
            Board B has two. One runs dsp_afe as "M": no balance, no doa,
            no gsc or bss, and the raw stream as modes 9 and 10 (ADR-0042,
            KEHOACH 2.3).

    choice APP_MIC_SLOT
        prompt "I2S slot of the one microphone"
        depends on APP_MIC_COUNT = 1
        default APP_MIC_SLOT_LEFT
        help
            The INMP441's L/R pin picks it: to GND is left, to VDD right.
            Board B's ch1, its better microphone, is the right slot.

        config APP_MIC_SLOT_LEFT
            bool "Left: L/R to GND"
        config APP_MIC_SLOT_RIGHT
            bool "Right: L/R to VDD"
    endchoice

    config APP_PCM_SHIFT_FALLBACK
        int "Microphone right shift until calib/pcm_shift is measured"
        range 8 16
        default 16
        help
            drv_audio keeps the top 32 - shift bits of each INMP441 slot.
            test_apps/calib writes the measured value to NVS calib/pcm_shift,
            which wins over this one (KEHOACH 6.2).

    config SR_PROFILING
        bool "Per-module timing into the bench CSV"
        default n
        help
            On only in the bench profile, the one profile numbers are
            reported from (KEHOACH 4.5.8).

endmenu
